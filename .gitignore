# QuéDice! · Lo que es propio de cada instalación no se sube al repositorio:
# así «git pull» en Plesk nunca pisa ajustes, credenciales ni conversaciones.

# wj-content: solo se versionan las reglas y los ejemplos
wj-content/*
!wj-content/.htaccess
!wj-content/config/
wj-content/config/*
!wj-content/config/.htaccess
!wj-content/config/ajustes.ejemplo.json.php
!wj-content/config/claves.ejemplo.php
!wj-content/config/.htpasswd.ejemplo
!wj-content/subidas/
wj-content/subidas/*
!wj-content/subidas/.htaccess

# Credenciales y copias en cualquier lugar
**/.htpasswd
**/.htpasswd.php
*.bak
*.old
*.orig
*~
*.swp
*.tmp
*.tmp.php
.env

# Herramientas de desarrollo (se instalan fuera del proyecto)
graphify-out/
repomix-output.*
.claude/
node_modules/
.DS_Store
Thumbs.db
