# QuéDice! · Gobernación de Nariño
# Reglas para Apache (Plesk usa Apache detrás de nginx por defecto).
# Si el servidor solo usa nginx, estas reglas no se aplican: ver README → «Solo nginx».

DirectoryIndex index.php
Options -Indexes

# HTTPS: actívalo en Plesk → Hosting y DNS → «Redirección 301 permanente de HTTP a HTTPS» y el HSTS en
# «SSL It!». (Aquí no se fuerza para no dejar el sitio caído si el certificado aún no está instalado;
# la aplicación envía Strict-Transport-Security cuando la visita llega por HTTPS.)

# Nada que empiece por punto: .git/ (código e historial si el sitio es un clon), .htaccess, .htpasswd…
# Se deja pasar /.well-known/ para que Let's Encrypt pueda renovar el certificado.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(?!well-known/)"
</IfModule>

# Documentación, temporales y archivos de configuración: nunca por la web (sin distinguir mayúsculas).
<FilesMatch "(?i)(^\.|\.(md|log|lock|tmp|bak|old|orig|sql|ini|json|dist|sh|yml|yaml|swp)$|~$|^(composer\.(json|lock)|package(-lock)?\.json)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
