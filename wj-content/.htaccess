# QuéDice! · Contenido escribible (ajustes, credenciales, conversaciones, bitácoras y subidas)
# Nada de esta carpeta se sirve por la web. La única excepción son las imágenes de
# wj-content/subidas/, que tiene su propio .htaccess.

Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
